{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "45b05a705a234b81bc4295a33d0bed57",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Get_Bayer (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -655.0,
            "y": 206.0,
            "width": 213.0,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b8435a999763490fbd7a517e8bed4987"
        },
        {
            "m_Id": "255d4c6079634b53814ad7eb14ca0f0f"
        },
        {
            "m_Id": "2d6a59cdbb934dfd9f7a24818ce12ff4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Get_Bayer",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 pos = screenPos.xy;\r\nfloat size = bayerSize;\r\n\r\n// Bayer matrices\r\nstatic const int bayer2[4] = { 0, 2, 3, 1 };\r\nstatic const int bayer4[16] = {\r\n    0, 8, 2, 10,\r\n    12, 4, 14, 6,\r\n    3, 11, 1, 9,\r\n    15, 7, 13, 5\r\n};\r\nstatic const int bayer8[64] = {\r\n    0, 32, 8, 40, 2, 34, 10, 42,\r\n    48, 16, 56, 24, 50, 18, 58, 26,\r\n    12, 44, 4, 36, 14, 46, 6, 38,\r\n    60, 28, 52, 20, 62, 30, 54, 22,\r\n    3, 35, 11, 43, 1, 33, 9, 41,\r\n    51, 19, 59, 27, 49, 17, 57, 25,\r\n    15, 47, 7, 39, 13, 45, 5, 37,\r\n    63, 31, 55, 23, 61, 29, 53, 21\r\n};\r\n\r\nint x = (int)pos.x;\r\nint y = (int)pos.y;\r\nfloat result = 0;\r\n\r\nif (size < 0.5) {\r\n    result = (bayer2[(x % 2) + (y % 2) * 2] / 4.0) - 0.5;\r\n} else if (size < 1.5) {\r\n    result = (bayer4[(x % 4) + (y % 4) * 4] / 16.0) - 0.5;\r\n} else {\r\n    result = (bayer8[(x % 8) + (y % 8) * 8] / 64.0) - 0.5;\r\n}\r\n\r\nbayerValue = result;"
}

